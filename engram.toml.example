[vault]
root = "C:/Users/ianfl/dev-vault"

[types]
enabled = ["decision","bug","pattern","context","runbook","session","concept"]

[embeddings]
provider = "ollama"
model = "bge-m3"
endpoint = "http://localhost:11434"

[synthesis]
# Path B summary model. Use a fast model: large coder models (e.g.
# qwen3-coder) cold-load >50s and exceed timeouts on real context.
model = "qwen2.5-coder:7b"
# Cold-load safety. First semantic query after model unload is slow; a low
# timeout spuriously falls back to raw notes. Default 120.
timeout_seconds = 120
# Keep Ollama models resident between queries (~4s warm vs ~58s cold).
keep_alive = "30m"

[limits]
rate_calls = 30
rate_window_seconds = 60
lock_timeout_seconds = 5
context_warning_pct = 35
context_critical_pct = 50

[retrieval]
# Path A recency boost (BL-01). recency_weight=0 disables (pure FTS rank).
recency_weight = 0.2
recency_halflife_days = 90
# Path B cheap rerank (BL-02): vec sim + keyword overlap + recency, zero LLM.
# Default off (pure KNN distance order).
rerank = false
